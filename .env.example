# AI Coding Mentor Configuration
# Copy this file to .env and fill in your values. Never commit .env to git!

# LLM Provider Configuration
# Supported providers: "openai", "openai-compatible", "mock"
MENTOR_LLM_PROVIDER=openai

# Model Name (e.g. gpt-4o, gpt-4o-mini, deepseek-chat, llama3:8b)
MENTOR_LLM_MODEL=gpt-4o-mini

# API Key for OpenAI or your compatible provider (e.g. sk-...)
OPENAI_API_KEY=your-api-key-here

# Optional: Base URL for custom endpoints (Ollama, LM Studio, OpenRouter, LocalAI)
# Example for Ollama: http://localhost:11434/v1
# Example for OpenRouter: https://openrouter.ai/api/v1
# MENTOR_LLM_BASE_URL=

# Mentor Behavior
# Initial assistance mode: hint, concept, pseudocode, review, solution
MENTOR_DEFAULT_MODE=hint

# Maximum conversation history turns to retain in context
MENTOR_MAX_HISTORY=20

# Safety & Permissions
# Auto-approve safe read operations (True/False)
MENTOR_AUTO_APPROVE_READS=True

# Allow code execution tool (must still require per-run confirmation)
MENTOR_ALLOW_CODE_EXECUTION=False

# Command execution timeout in seconds
MENTOR_RUNNER_TIMEOUT=15

# Logging level: DEBUG, INFO, WARNING, ERROR
MENTOR_LOG_LEVEL=INFO
